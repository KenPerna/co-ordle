{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.web"
  },
  "deploy": {
    "startCommand": "sh -c \"exec serve artifacts/web-app/dist/public -l tcp://0.0.0.0:${PORT:-3000}\"",
    "restartPolicyType": "ON_FAILURE"
  }
}
