FROM node:22-slim AS builder
RUN npm install -g pnpm@9.15.9
WORKDIR /app
COPY . .
RUN pnpm install --no-frozen-lockfile

RUN echo "VITE_API_URL is: $VITE_API_URL"
ARG VITE_API_URL
RUN echo "VITE_API_URL as ARG is: $VITE_API_URL"

RUN pnpm --filter @workspace/web-app run build
RUN npm install -g serve
ARG CACHEBUST=3
CMD ["sh", "-c", "exec serve -s artifacts/web-app/dist/public -l tcp://0.0.0.0:${PORT:-3000}"]